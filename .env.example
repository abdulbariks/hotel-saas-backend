# Database
# Neon PostgreSQL (serverless). Create a free database at https://neon.tech
# and paste the connection string from the Neon dashboard.
# The pgbouncer=true flag is required for Neon's PgBouncer pooler
# (Prisma Client cannot use prepared statements over the pooler).
# channel_binding=disable is required in some sandboxed environments.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&channel_binding=disable"

# JWT secret - generate a long random value for production
JWT_SECRET="replace-me"

# Server port
PORT=5000